# ==========================================
# CraftConnect Environment Configuration
# INT253 CA3 Project - Lovely Professional University
# ==========================================

# Django Security
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL / Supabase or SQLite Dev Fallback)
USE_SQLITE=False
# Supabase URI (recommended):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or discrete PostgreSQL parameters:
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# External AI Service (Open-source AI via OpenRouter / Hugging Face / OpenAI compatible)
# Default is OpenRouter which routes to open-source models like Llama, Gemma, Mistral, Qwen
AI_PROVIDER=openrouter
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openrouter/auto
AI_API_KEY=sk-or-v1-your_openrouter_api_key_here
